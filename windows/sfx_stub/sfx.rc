#include <winuser.h>
1 ICON "../openrar/resources/sfx.ico"
1 RT_MANIFEST "sfx.manifest"
1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "Self-extracting archive"
      VALUE "ProductName", "OpenRAR SFX"
      VALUE "FileVersion", "1.0.0.0"
      VALUE "ProductVersion", "1.0.0.0"
      VALUE "LegalCopyright", "Free software"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
